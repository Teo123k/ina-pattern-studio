NODE_ENV=development
PORT=3030
# Comma-separated numeric Telegram account IDs allowed to create or update projects.
ALLOWED_TELEGRAM_IDS=123456789
# Required for the production PostgreSQL repository. Leave unset only for test/local memory mode.
DATABASE_URL=postgres://ina:development-only-change-me@127.0.0.1:54329/ina_pattern_studio_test
# Set to s3 in production. Local media is for development only.
OBJECT_STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=./service/.local-media
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=ina-pattern-studio-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required by the HTTP tool service in a shared environment.
SERVICE_API_KEY=replace-with-a-long-random-secret
# Shared only with the trusted Telegram gateway; never expose in Hermes prompts.
TELEGRAM_APPROVAL_SECRET=replace-with-a-second-long-random-secret
# Optional Etsy draft adapter; never enable without an approved shop OAuth connection.
# ETSY_SHOP_ID=
# ETSY_API_KEY=
# ETSY_API_SECRET=
# ETSY_ACCESS_TOKEN=
# Optional WordPress.com publishing adapter. Use a site numeric ID and OAuth token; keep both out of prompts and Git.
# WORDPRESS_SITE_ID=
# WORDPRESS_ACCESS_TOKEN=
