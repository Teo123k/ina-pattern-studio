{
  "name": "ina-pattern-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=service/.env service/src/server.mjs",
    "dev": "node --env-file-if-exists=service/.env --watch service/src/server.mjs",
    "mcp": "node service/src/mcp-server.mjs",
    "test": "node --test agent/tools/validate-pattern.test.mjs agent/tools/validate-structured-pattern.test.mjs service/src/video/edit-decision.test.mjs service/src/adapters/etsy-adapter.test.mjs tools/build-project-context.test.mjs service/test/**/*.test.mjs",
    "migrate": "node service/src/migrate.mjs",
    "test:integration": "node --test service/test/**/*.integration.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.907.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  }
}
