{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INA Telegram project intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "received_at", "project_action", "source_files", "measurements"],
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "received_at": { "type": "string", "format": "date-time" },
    "project_action": { "enum": ["new", "update"] },
    "project_id": { "type": ["string", "null"], "pattern": "^INA-[0-9]{2,}$" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "storage_key"],
        "properties": {
          "kind": { "enum": ["photo", "sketch", "pdf", "video"] },
          "storage_key": { "type": "string", "minLength": 1 }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diameter_cm", "height_cm", "fitting_description", "confirmed_by_ivana"],
      "properties": {
        "diameter_cm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "height_cm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "fitting_description": { "type": ["string", "null"] },
        "confirmed_by_ivana": { "type": "boolean" }
      }
    }
  }
}
