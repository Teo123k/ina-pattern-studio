{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INA Pattern Studio design brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "design_id",
    "provenance",
    "frame",
    "materials",
    "skill_level",
    "style_constraints",
    "commercial_scope"
  ],
  "properties": {
    "design_id": { "type": "string", "pattern": "^INA-[0-9]{2,}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_original", "notes"],
      "properties": {
        "is_original": { "const": true },
        "notes": { "type": "string", "minLength": 20 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter_cm", "height_cm", "fitting_description"],
      "properties": {
        "shape": { "const": "drum" },
        "diameter_cm": { "type": "number", "exclusiveMinimum": 0 },
        "height_cm": { "type": "number", "exclusiveMinimum": 0 },
        "fitting_description": { "type": "string", "minLength": 10 }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yarn_weight", "yarn_fibre", "hook_mm", "gauge_stitches_per_10cm", "gauge_rows_per_10cm"],
      "properties": {
        "yarn_weight": { "type": "string", "minLength": 2 },
        "yarn_fibre": { "type": "string", "minLength": 2 },
        "hook_mm": { "type": "number", "exclusiveMinimum": 0 },
        "gauge_stitches_per_10cm": { "type": "number", "exclusiveMinimum": 0 },
        "gauge_rows_per_10cm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "skill_level": { "enum": ["confident_beginner", "intermediate", "advanced"] },
    "style_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_direction", "motif_repeat_stitches", "avoid"],
      "properties": {
        "visual_direction": { "type": "string", "minLength": 20 },
        "motif_repeat_stitches": { "type": "integer", "minimum": 2 },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commercial_scope": { "const": "digital_pattern_only" }
  }
}
